<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CHI TIẾT CÔNG VIỆC"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:layout_marginBottom="20dp" />

    <!-- Hien thi ma cong viec -->
    <TextView
        android:id="@+id/tvHienThiMa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mã công việc: "
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvHienThiTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên: "
        android:textSize="18sp"
        android:textColor="#000000"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvHienThiMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mô tả: "
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvHienThiTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Chưa hoàn thành"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:layout_marginBottom="16dp" />

    <!-- Nut Hoan thanh -->
    <Button
        android:id="@+id/btnHoanThanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hoàn thành công việc"
        android:backgroundTint="#4CAF50"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa công việc"
        android:backgroundTint="#FF9800" />

</LinearLayout>